# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
MONGO_URL=
PORT=
NODE_ENV=

# ---------------------------------------------------------------
# RAZORPAY  -  ONE mode, ONE key pair, used everywhere.
# Flip RAZORPAY_MODE to switch. Nothing else needs to change and
# no key literal exists anywhere else in the codebase.
# ---------------------------------------------------------------
RAZORPAY_MODE=test

RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=

# Fill these in before setting RAZORPAY_MODE=test
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=

# Dashboard -> Settings -> Webhooks. Needed for /api/v1/payment/webhook.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Auth
# ---------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_TIME=

# ---------------------------------------------------------------
# Mail
# ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

# ---------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# ---------------------------------------------------------------
# WhatsApp gateway
# ---------------------------------------------------------------
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# ---------------------------------------------------------------
# URLs
# FRONTEND_URL is where payment redirects land - it MUST match the
# site the customer is actually on, or they get bounced to a dead page.
# ---------------------------------------------------------------
BACKEND_URL=
FRONTEND_URL=

# Comma separated. Leave empty to allow all origins (dev only).
CORS_ORIGINS=

# ---------------------------------------------------------------
# Admin panel credentials
# ---------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

PARTNER_ID=
GOOGLE_MAP_KEY=
