# # Backend API base (everything in the app is relative to this)
# VITE_REACT_APP_BACKEND_URL=http://localhost:7485/api/v1
# # Server origin without /api/v1 (used by the few non-versioned routes)
# VITE_REACT_APP_API_ORIGIN=http://localhost:7485

# Production example:
VITE_REACT_APP_BACKEND_URL=https://api.naideal.com/api/v1
VITE_REACT_APP_API_ORIGIN=https://api.naideal.com
